import os
import shutil
from mutagen.easyid3 import EasyID3
from mutagen import File

# Configuration
SOURCE_DIR = "/path/to/your/music"
TARGET_DIR = "/path/to/your/organized_music"

# Define your genre map (Mapping messy tags to clean folder names)
GENRE_MAP = {
    'Dancehall': 'Dancehall',
    'Pop': 'Pop',
    'House': 'House',
    'Riddim': 'Riddims',
    'Gengetone': 'Gengetone',
    'Reggae': 'Reggae'
}

def get_genre(file_path):
    """Attempt to get genre from ID3 tags, fallback to keyword search."""
    try:
        audio = EasyID3(file_path)
        if 'genre' in audio:
            genre = audio['genre'][0]
            # Match against our map
            for key, folder in GENRE_MAP.items():
                if key.lower() in genre.lower():
                    return folder
    except:
        pass

    # Fallback: Keyword search in filename
    filename = os.path.basename(file_path).lower()
    for key, folder in GENRE_MAP.items():
        if key.lower() in filename:
            return folder
            
    return "Misc"

def organize():
    for root, dirs, files in os.walk(SOURCE_DIR):
        for file in files:
            if file.endswith(('.mp3', '.m4a')):
                file_path = os.path.join(root, file)
                
                # Determine destination
                category = get_genre(file_path)
                dest_path = os.path.join(TARGET_DIR, category)
                
                if not os.path.exists(dest_path):
                    os.makedirs(dest_path)
                
                print(f"Moving: {file} -> {category}")
                shutil.move(file_path, os.path.join(dest_path, file))

if __name__ == "__main__":
    organize()
